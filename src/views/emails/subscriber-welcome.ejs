<%
  // Variables passed in: { subscriber, appName, settings }
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var appUrl = appUrl || (settings && settings.app_url) || 'https://iavmn.org.ng';

  // Build unsubscribe URL from the token
  var unsubscribeUrl = appUrl + '/unsubscribe/' + (subscriber.unsub_token || '');
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to the <%= siteShort %> newsletter</title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 32px 28px; text-align: center;">
              <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 4px;">
                <%= siteName %>
              </div>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding: 34px 28px 12px;">
              <h1 style="margin: 0 0 18px; font-size: 24px; color: #25573f; line-height: 1.3;">
                You're on the list! 🎉
              </h1>
              <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.7;">
                Thank you for subscribing to the <%= siteShort %> newsletter. You'll be the first to hear about:
              </p>
            </td>
          </tr>

          <!-- What to expect -->
          <tr>
            <td style="padding: 0 28px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f7faf9; border-radius: 8px;">
                <tr>
                  <td style="padding: 22px 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding: 6px 0; font-size: 15px; line-height: 1.6;">
                          <span style="color: #b9a446; font-weight: 700; margin-right: 8px;">✦</span>
                          Upcoming events and conferences
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 15px; line-height: 1.6;">
                          <span style="color: #b9a446; font-weight: 700; margin-right: 8px;">✦</span>
                          New training and certification programmes
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 15px; line-height: 1.6;">
                          <span style="color: #b9a446; font-weight: 700; margin-right: 8px;">✦</span>
                          Industry insights and updates
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 15px; line-height: 1.6;">
                          <span style="color: #b9a446; font-weight: 700; margin-right: 8px;">✦</span>
                          Announcements from the Institute
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding: 8px 28px 20px;">
              <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.7;">
                In the meantime, explore our website:
              </p>
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #25573f; border-radius: 6px;">
                    <a href="<%= appUrl %>"
                       style="display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">
                      Visit <%= siteShort %>
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- What email -->
          <tr>
            <td style="padding: 8px 28px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #dfeae8;">
                <tr>
                  <td style="padding-top: 18px;">
                    <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.6;">
                      You're receiving this email because <strong><%= subscriber.email %></strong> was subscribed to our newsletter.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Unsubscribe -->
          <tr>
            <td style="background-color: #edf3f2; padding: 20px 28px; border-top: 1px solid #dfeae8;">
              <p style="margin: 0 0 8px; font-size: 12px; color: #6c757d;">
                Changed your mind? You can unsubscribe at any time — no hard feelings.
              </p>
              <p style="margin: 0; font-size: 12px;">
                <a href="<%= unsubscribeUrl %>" style="color: #6c757d; text-decoration: underline;">
                  Unsubscribe from this list
                </a>
              </p>
            </td>
          </tr>

        </table>

        <p style="margin: 16px 0 0; font-size: 12px; color: #6c757d; text-align: center;">
          &copy; <%= new Date().getFullYear() %> <%= siteName %>
        </p>

      </td>
    </tr>
  </table>

</body>
</html>