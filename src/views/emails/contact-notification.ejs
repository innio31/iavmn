<%
  // Variables passed in: { message, appName, settings }
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var appUrl = (settings && settings.app_url) || process.env.APP_URL || 'http://localhost:3000';
  var receivedAt = message.created_at
    ? new Date(message.created_at).toLocaleString('en-GB', {
        day: '2-digit', month: 'long', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      })
    : new Date().toLocaleString('en-GB');
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Contact Message</title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 24px 28px; text-align: center;">
              <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 4px;">
                New Contact Message
              </div>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding: 28px 28px 8px;">
              <p style="margin: 0 0 12px; font-size: 15px;">
                A new message was submitted through the contact form on <strong><%= siteName %></strong>.
              </p>
              <p style="margin: 0; font-size: 13px; color: #6c757d;">
                Received: <%= receivedAt %>
              </p>
            </td>
          </tr>

          <!-- Sender info -->
          <tr>
            <td style="padding: 16px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f7faf9; border-left: 4px solid #25573f; border-radius: 6px;">
                <tr>
                  <td style="padding: 18px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 4px; font-weight: 700;">From</td>
                      </tr>
                      <tr>
                        <td style="font-size: 16px; font-weight: 700; color: #25573f; padding-bottom: 12px;">
                          <%= message.name %>
                        </td>
                      </tr>

                      <tr>
                        <td style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 4px; font-weight: 700;">Email</td>
                      </tr>
                      <tr>
                        <td style="font-size: 15px; padding-bottom: 12px;">
                          <a href="mailto:<%= message.email %>" style="color: #25573f; text-decoration: none; font-weight: 600;">
                            <%= message.email %>
                          </a>
                        </td>
                      </tr>

                      <% if (message.phone) { %>
                        <tr>
                          <td style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 4px; font-weight: 700;">Phone</td>
                        </tr>
                        <tr>
                          <td style="font-size: 15px; padding-bottom: 12px;">
                            <a href="tel:<%= message.phone.replace(/\s+/g, '') %>" style="color: #25573f; text-decoration: none; font-weight: 600;">
                              <%= message.phone %>
                            </a>
                          </td>
                        </tr>
                      <% } %>

                      <% if (message.subject) { %>
                        <tr>
                          <td style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 4px; font-weight: 700;">Subject</td>
                        </tr>
                        <tr>
                          <td style="font-size: 15px; color: #212529;">
                            <%= message.subject %>
                          </td>
                        </tr>
                      <% } %>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Message body -->
          <tr>
            <td style="padding: 8px 28px 20px;">
              <div style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 8px; font-weight: 700;">Message</div>
              <div style="font-size: 15px; line-height: 1.7; color: #212529; white-space: pre-wrap; padding: 16px 18px; background-color: #f7faf9; border-radius: 6px; border: 1px solid #dfeae8;">
                <%= message.message %>
              </div>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding: 8px 28px 28px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #25573f; border-radius: 6px;">
                    <a href="mailto:<%= message.email %>?subject=<%= encodeURIComponent('Re: ' + (message.subject || 'Your message to ' + siteShort)) %>"
                       style="display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">
                      Reply to <%= message.name %>
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #edf3f2; padding: 20px 28px; border-top: 1px solid #dfeae8;">
              <p style="margin: 0 0 6px; font-size: 13px; color: #6c757d;">
                This message is also available in your admin dashboard.
              </p>
              <p style="margin: 0; font-size: 13px;">
                <a href="<%= appUrl %>/admin/messages"
                   style="color: #25573f; text-decoration: none; font-weight: 600;">
                  Open Admin Inbox &rarr;
                </a>
              </p>
            </td>
          </tr>

        </table>

        <p style="margin: 16px 0 0; font-size: 12px; color: #6c757d; text-align: center;">
          &copy; <%= new Date().getFullYear() %> <%= siteName %>
        </p>

      </td>
    </tr>
  </table>

</body>
</html>