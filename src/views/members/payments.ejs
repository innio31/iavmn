<%
  const statusBadge = (s) => {
    if (s === 'paid') return { cls: 'm-pay-paid', label: 'Paid' };
    if (s === 'pending') return { cls: 'm-pay-pending', label: 'Pending' };
    if (s === 'failed') return { cls: 'm-pay-failed', label: 'Failed' };
    if (s === 'refunded') return { cls: 'm-pay-refunded', label: 'Refunded' };
    return { cls: 'm-pay-pending', label: s || '—' };
  };

  const currencySymbol = (c) => {
    if (c === 'NGN') return '₦';
    if (c === 'USD') return '$';
    if (c === 'GBP') return '£';
    if (c === 'EUR') return '€';
    if (c === 'GHS') return '₵';
    if (c === 'KES') return 'KSh';
    if (c === 'ZAR') return 'R';
    return c + ' ';
  };
%>

<div class="m-page-head">
  <div>
    <h1 class="m-page-title">Payment History</h1>
    <p class="m-page-sub">All payments you've made to the Institute.</p>
  </div>
  <div class="m-page-actions">
    <a href="/member" class="btn btn-outline">Back to Dashboard</a>
  </div>
</div>

<%# ─── Total paid summary ─── %>
<div class="m-card m-summary-card">
  <div class="m-summary-label">Total paid</div>
  <div class="m-summary-value">
    ₦ <%= Number(totalPaid || 0).toLocaleString() %>
  </div>
  <div class="m-summary-sub">
    <%= payments.length %> payment<%= payments.length === 1 ? '' : 's' %> on record
  </div>
</div>

<% if (!payments || payments.length === 0) { %>

  <div class="m-card">
    <div class="m-empty">
      <div class="m-empty-icon">₦</div>
      <div class="m-empty-title">No payments yet</div>
      <p class="m-empty-text">
        When you complete a membership payment, it will appear here along with a receipt.
      </p>
    </div>
  </div>

<% } else { %>

  <%# ─── Desktop table ─── %>
  <div class="m-card hide-mobile" style="padding: 0; overflow: hidden;">
    <div class="m-table-wrap">
      <table class="m-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Reference</th>
            <th>Tier</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% payments.forEach((p) => { %>
            <%
              const paidDate = p.payment_paid_at || p.created_at;
              const b = statusBadge(p.payment_status);
              const cur = p.payment_currency || p.tier_currency || 'NGN';
            %>
            <tr>
              <td>
                <span class="m-table-date"><%= fmtDate(paidDate) %></span>
              </td>
              <td>
                <code class="m-table-ref"><%= p.reference %></code>
              </td>
              <td>
                <span class="m-table-tier"><%= p.tier_name || '—' %></span>
              </td>
              <td>
                <strong class="m-table-amount">
                  <%= currencySymbol(cur) %><%= Number(p.payment_amount || 0).toLocaleString() %>
                </strong>
              </td>
              <td>
                <span class="m-pay-badge <%= b.cls %>"><%= b.label %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ─── Mobile cards ─── %>
  <div class="show-mobile">
    <% payments.forEach((p) => { %>
      <%
        const paidDate = p.payment_paid_at || p.created_at;
        const b = statusBadge(p.payment_status);
        const cur = p.payment_currency || p.tier_currency || 'NGN';
      %>
      <div class="m-card m-payment-card">
        <div class="m-payment-head">
          <div class="m-payment-amount">
            <%= currencySymbol(cur) %><%= Number(p.payment_amount || 0).toLocaleString() %>
          </div>
          <span class="m-pay-badge <%= b.cls %>"><%= b.label %></span>
        </div>

        <div class="m-payment-details">
          <div class="m-info-row">
            <span class="m-info-label">Date</span>
            <span class="m-info-value"><%= fmtDate(paidDate) %></span>
          </div>
          <div class="m-info-row">
            <span class="m-info-label">Tier</span>
            <span class="m-info-value"><%= p.tier_name || '—' %></span>
          </div>
          <div class="m-info-row">
            <span class="m-info-label">Reference</span>
            <span class="m-info-value m-info-mono"><%= p.reference %></span>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <p class="m-payments-note">
    Need a receipt or have a question about a payment?
    <a href="/contact">Contact the Institute</a>.
  </p>

<% } %>