<%
  var firstName = (user.name || '').split(/\s+/)[0] || 'there';
%>

<div class="auth-icon-wrap">🔒</div>
<h1 class="auth-title">Reset your password</h1>
<p class="auth-subtitle">
  Hi <%= firstName %>, choose a new password for your admin account.
</p>

<% if (errors && errors.length) { %>
  <div class="auth-errors">
    <strong>Please fix the following:</strong>
    <ul>
      <% errors.forEach((e) => { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form action="/reset-password/<%= token %>" method="POST" class="auth-form" novalidate>

  <div class="form-row">
    <label for="password">New password</label>
    <input
      type="password"
      id="password"
      name="password"
      required
      minlength="8"
      maxlength="100"
      autocomplete="new-password"
      autofocus
      oninput="checkStrength()">
    <div class="password-strength">
      <div class="password-strength-fill" id="strengthFill"></div>
    </div>
    <span class="password-strength-label" id="strengthLabel">At least 8 characters.</span>
  </div>

  <div class="form-row">
    <label for="password_confirm">Confirm new password</label>
    <input
      type="password"
      id="password_confirm"
      name="password_confirm"
      required
      minlength="8"
      maxlength="100"
      autocomplete="new-password"
      oninput="checkMatch()">
    <div class="password-match" id="matchHint"></div>
  </div>

  <button type="submit" class="btn btn-primary">Reset Password</button>
</form>

<p class="auth-links">
  <a href="/login">&larr; Back to Login</a>
</p>

<script>
  function evaluateStrength(value) {
    var score = 0;
    if (!value) return 0;
    if (value.length >= 8) score++;
    if (value.length >= 12) score++;
    if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score++;
    if (/[0-9]/.test(value)) score++;
    if (/[^A-Za-z0-9]/.test(value)) score++;
    return score;
  }

  function checkStrength() {
    var v = document.getElementById('password').value;
    var fill = document.getElementById('strengthFill');
    var label = document.getElementById('strengthLabel');
    var score = evaluateStrength(v);

    var width = '0%';
    var color = '#e2e8ea';
    var text = 'At least 8 characters.';

    if (v.length === 0) {
      width = '0%';
      color = '#e2e8ea';
    } else if (v.length < 8) {
      width = '30%';
      color = '#c0392b';
      text = 'Too short — minimum 8 characters.';
    } else if (score <= 2) {
      width = '55%';
      color = '#e67e22';
      text = 'Weak — consider adding uppercase, numbers, or symbols.';
    } else if (score === 3) {
      width = '75%';
      color = '#b9a446';
      text = 'Good password.';
    } else {
      width = '100%';
      color = '#25573f';
      text = 'Strong password.';
    }

    fill.style.width = width;
    fill.style.background = color;
    label.textContent = text;
    label.style.color = color === '#e2e8ea' ? '#6c757d' : color;

    checkMatch();
  }

  function checkMatch() {
    var p = document.getElementById('password').value;
    var c = document.getElementById('password_confirm').value;
    var hint = document.getElementById('matchHint');
    if (!c) { hint.textContent = ''; return; }
    if (p === c) {
      hint.textContent = '✓ Passwords match';
      hint.style.color = '#25573f';
    } else {
      hint.textContent = '✗ Passwords do not match';
      hint.style.color = '#c0392b';
    }
  }
</script>