<%
  const isEdit = mode === 'edit';
  const action = isEdit ? `/admin/tiers/${tier.id}` : '/admin/tiers';
  const pageTitle = isEdit ? 'Edit Membership Tier' : 'New Membership Tier';

  // Curated icon set — safe, cross-platform emojis
  const iconChoices = [
    '🎓', '👥', '💼', '🏅', '⭐', '✓', '◆', '▲',
    '🔑', '📘', '📗', '📙', '🛡️', '🏛️', '🌐', '💠',
  ];

  const suggestedSlug = (tier.name || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

  const currencies = ['NGN', 'USD', 'GBP', 'EUR', 'GHS', 'KES', 'ZAR'];

  // Helper to check if this is a "quote-based" tier (both fees are 0)
  const isQuoteBased = Number(tier.fee_amount || 0) === 0 && Number(tier.registration_fee || 0) === 0;

  // Helper to compute the total
  const totalAmount = Number(tier.fee_amount || 0) + Number(tier.registration_fee || 0);
%>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= pageTitle %></h1>
    <p class="page-subtitle">
      <a href="/admin/tiers">&larr; Back to Membership Tiers</a>
    </p>
  </div>
</div>

<% if (errors && errors.length) { %>
  <div class="admin-card" style="border-color: #f5c6cb; background: #f8d7da; color: #721c24;">
    <strong>Please fix the following:</strong>
    <ul style="margin: 8px 0 0; padding-left: 20px;">
      <% errors.forEach((e) => { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form action="<%= action %>" method="POST" class="admin-card" novalidate>

  <div class="form-row">
    <label for="name">Tier name <span style="color: #c0392b;">*</span></label>
    <input
      type="text"
      id="name"
      name="name"
      value="<%= tier.name || '' %>"
      required
      minlength="2"
      maxlength="120"
      placeholder="e.g. Student Member"
      autofocus
      oninput="suggestSlug()">
  </div>

  <div class="form-row">
    <label for="slug">Custom URL (optional)</label>
    <input
      type="text"
      id="slug"
      name="slug"
      value="<%= tier.slug || '' %>"
      maxlength="60"
      pattern="[a-z0-9-]+"
      placeholder="<%= suggestedSlug || 'auto-generated-from-name' %>">
    <span class="form-hint">
      Leave blank to auto-generate from the name.
      URL will be <code>/membership/<span id="slugPreview"><%= tier.slug || suggestedSlug || 'auto' %></span></code>.
    </span>
  </div>

  <div class="form-row">
    <label for="short_description">Short description</label>
    <input
      type="text"
      id="short_description"
      name="short_description"
      value="<%= tier.short_description || '' %>"
      maxlength="255"
      placeholder="A one-line summary shown in lists.">
    <span class="form-hint">Max 255 characters. Shown on cards and listings.</span>
  </div>

  <div class="form-row">
    <label for="description">Full description</label>
    <textarea
      id="description"
      name="description"
      rows="6"
      placeholder="Who should join, requirements, benefits..."><%= tier.description || '' %></textarea>
    <span class="form-hint">Shown on the tier detail page. Line breaks are preserved.</span>
  </div>

  <div class="form-row">
    <label for="icon">Icon</label>

    <div class="icon-picker">
      <% iconChoices.forEach((ic) => { %>
        <button
          type="button"
          class="icon-choice <%= tier.icon === ic ? 'selected' : '' %>"
          data-icon="<%= ic %>"
          onclick="pickIcon('<%= ic %>')"
          aria-label="Choose icon <%= ic %>">
          <%= ic %>
        </button>
      <% }); %>
    </div>

    <input
      type="text"
      id="icon"
      name="icon"
      value="<%= tier.icon || '' %>"
      maxlength="80"
      placeholder="Or paste any emoji/character"
      style="margin-top: 10px;"
      oninput="updateIconPicker()">
    <span class="form-hint">Pick from above, or paste your own emoji/character.</span>
  </div>

  <%# ─── FEES SECTION ─── %>
  <hr class="admin-divider">
  <h3 class="admin-section-heading">Fees</h3>

  <p class="text-muted" style="margin: 0 0 18px; font-size: 14px; line-height: 1.6;">
    Every tier has two fees:
    <strong>Registration</strong> (the application form, typically the same for all tiers)
    and <strong>Membership</strong> (the annual fee specific to this tier).
    The total is what the applicant pays online.
    <br>
    <br>
    <strong>To make this tier "quote-based"</strong> (no online payment — applicant gets contacted by your team),
    set <em>both</em> fees to 0.
  </p>

  <div class="form-row form-row-split-fees">
    <div>
      <label for="registration_fee">Registration fee</label>
      <input
        type="number"
        id="registration_fee"
        name="registration_fee"
        value="<%= tier.registration_fee !== undefined && tier.registration_fee !== null ? tier.registration_fee : 20000 %>"
        min="0"
        step="0.01"
        inputmode="decimal"
        oninput="updateTotal()">
      <span class="form-hint">Fixed form/registration charge. Typically 20,000 for all tiers.</span>
    </div>

    <div>
      <label for="fee_amount">Membership fee</label>
      <input
        type="number"
        id="fee_amount"
        name="fee_amount"
        value="<%= tier.fee_amount !== undefined && tier.fee_amount !== null ? tier.fee_amount : 0 %>"
        min="0"
        step="0.01"
        inputmode="decimal"
        oninput="updateTotal()">
      <span class="form-hint">Annual membership fee for this tier.</span>
    </div>

    <div>
      <label for="currency">Currency</label>
      <select id="currency" name="currency">
        <% currencies.forEach((c) => { %>
          <option value="<%= c %>" <%= tier.currency === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="tier-total-box" id="totalBox">
    <div class="tier-total-row">
      <span class="tier-total-label">Registration</span>
      <span class="tier-total-value" id="totalRegistration">₦ 0</span>
    </div>
    <div class="tier-total-row">
      <span class="tier-total-label">Membership</span>
      <span class="tier-total-value" id="totalMembership">₦ 0</span>
    </div>
    <div class="tier-total-row tier-total-row-bold">
      <span class="tier-total-label">Total applicant pays</span>
      <span class="tier-total-value" id="totalGrand">₦ 0</span>
    </div>
  </div>

  <div class="tier-quote-notice" id="quoteNotice" style="display: none;">
    <strong>Quote-based tier.</strong>
    With both fees at zero, the application will be submitted without online payment.
    Your team will be notified and can contact the applicant with a custom quote.
  </div>

  <hr class="admin-divider">

  <div class="form-row">
    <label for="sort_order">Display order</label>
    <input
      type="number"
      id="sort_order"
      name="sort_order"
      value="<%= tier.sort_order !== undefined && tier.sort_order !== null ? tier.sort_order : 0 %>"
      min="0"
      max="9999"
      inputmode="numeric">
    <span class="form-hint">Lower numbers appear first (e.g. Student = 1, Associate = 3).</span>
  </div>

  <div class="form-row">
    <label class="checkbox-label">
      <input
        type="checkbox"
        name="is_active"
        value="1"
        <%= tier.is_active ? 'checked' : '' %>>
      <span>Active (visible on the public site)</span>
    </label>
  </div>

  <div class="settings-actions">
    <button type="submit" class="btn btn-primary">
      <%= isEdit ? 'Save Changes' : 'Create Tier' %>
    </button>
    <a href="/admin/tiers" class="btn btn-outline">Cancel</a>
  </div>

</form>

<script>
  function suggestSlug() {
    const nameInput = document.getElementById('name');
    const slugInput = document.getElementById('slug');
    const preview = document.getElementById('slugPreview');
    if (slugInput.value.trim() === '') {
      const generated = nameInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      preview.textContent = generated || 'auto';
    }
  }

  document.getElementById('slug').addEventListener('input', function () {
    const preview = document.getElementById('slugPreview');
    const v = this.value.trim();
    if (v === '') {
      suggestSlug();
    } else {
      preview.textContent = v
        .toLowerCase()
        .replace(/[^a-z0-9-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }
  });

  function pickIcon(icon) {
    document.getElementById('icon').value = icon;
    updateIconPicker();
  }

  function updateIconPicker() {
    const current = document.getElementById('icon').value.trim();
    document.querySelectorAll('.icon-choice').forEach((btn) => {
      btn.classList.toggle('selected', btn.dataset.icon === current);
    });
  }

  // ─── Live total calculation ───
  function formatMoney(amount, currency) {
    const symbols = {
      NGN: '₦', USD: '$', GBP: '£', EUR: '€', GHS: '₵', KES: 'KSh', ZAR: 'R',
    };
    const sym = symbols[currency] || currency + ' ';
    return sym + ' ' + Number(amount || 0).toLocaleString();
  }

  function updateTotal() {
    const reg = Number(document.getElementById('registration_fee').value) || 0;
    const mem = Number(document.getElementById('fee_amount').value) || 0;
    const currency = document.getElementById('currency').value;
    const total = reg + mem;

    document.getElementById('totalRegistration').textContent = formatMoney(reg, currency);
    document.getElementById('totalMembership').textContent = formatMoney(mem, currency);
    document.getElementById('totalGrand').textContent = formatMoney(total, currency);

    const quoteNotice = document.getElementById('quoteNotice');
    if (total === 0) {
      quoteNotice.style.display = 'block';
    } else {
      quoteNotice.style.display = 'none';
    }
  }

  // Initialize on page load
  updateTotal();

  // Also update when currency changes
  document.getElementById('currency').addEventListener('change', updateTotal);
</script>