<%
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var appUrl = (settings && settings.app_url) || 'http://localhost:3000';
  var firstName = (application.full_name || '').split(/\s+/)[0] || 'there';

  var feeCurrency = application.payment_currency || application.tier_currency || 'NGN';
  var feeAmount = Number(application.payment_amount || application.tier_fee || 0);

  var paidAt = application.payment_paid_at
    ? new Date(application.payment_paid_at).toLocaleString('en-GB', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : new Date().toLocaleString('en-GB');
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment confirmed</title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 28px; text-align: center;">
              <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 4px;">
                Payment Confirmation
              </div>
            </td>
          </tr>

          <!-- Checkmark -->
          <tr>
            <td style="padding: 32px 28px 0; text-align: center;">
              <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: #d4edda; color: #155724; font-size: 32px; font-weight: 700;">
                ✓
              </div>
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td style="padding: 20px 28px 12px; text-align: center;">
              <h1 style="margin: 0 0 12px; font-size: 22px; color: #25573f; line-height: 1.3;">
                Payment received — thank you, <%= firstName %>!
              </h1>
              <p style="margin: 0; font-size: 15px; line-height: 1.7;">
                We've received your payment for <strong><%= application.tier_name %></strong> membership.
              </p>
            </td>
          </tr>

          <!-- Receipt -->
          <tr>
            <td style="padding: 20px 28px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f7faf9; border-left: 4px solid #25573f; border-radius: 8px;">
                <tr>
                  <td style="padding: 18px 20px;">
                    <div style="font-size: 11px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 12px;">Payment receipt</div>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d; width: 45%;">Amount paid</td>
                        <td style="padding: 6px 0; font-size: 15px; color: #25573f; font-weight: 700;"><%= feeCurrency %> <%= feeAmount.toLocaleString() %></td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Date</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529;"><%= paidAt %></td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Reference</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529; font-family: monospace;"><%= application.reference %></td>
                      </tr>
                      <% if (application.payment_reference) { %>
                        <tr>
                          <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Payment ID</td>
                          <td style="padding: 6px 0; font-size: 13px; color: #212529; font-family: monospace; word-break: break-all;"><%= application.payment_reference %></td>
                        </tr>
                      <% } %>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- What's next -->
          <tr>
            <td style="padding: 16px 28px 20px;">
              <h2 style="margin: 0 0 12px; font-size: 16px; color: #25573f;">What happens next?</h2>
              <ol style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.9; color: #212529;">
                <li>Our membership team will review your application.</li>
                <li>This usually takes 3–5 business days.</li>
                <li>You'll receive an email with the outcome.</li>
              </ol>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #edf3f2; padding: 20px 28px; border-top: 1px solid #dfeae8;">
              <p style="margin: 0 0 8px; font-size: 12px; color: #6c757d; line-height: 1.6;">
                Keep this email as your payment receipt. If you have any questions, contact us at
                <a href="mailto:<%= (settings && settings.contact_email) || 'info@iavmn.org' %>" style="color: #25573f; text-decoration: none;">
                  <%= (settings && settings.contact_email) || 'info@iavmn.org' %>
                </a>
              </p>
              <p style="margin: 0; font-size: 12px; color: #6c757d;">
                &copy; <%= new Date().getFullYear() %> <%= siteName %>
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>