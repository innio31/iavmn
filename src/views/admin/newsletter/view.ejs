<%
  const fmtDateTime = (dt) => {
    if (!dt) return '—';
    const d = new Date(dt);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  };

  const statusBadge = (s) => {
    if (s === 'sent') return 'badge-success';
    if (s === 'sending') return 'badge-info';
    if (s === 'failed') return 'badge-danger';
    if (s === 'cancelled') return 'badge-muted';
    return 'badge-warning';
  };

  const statusLabel = (s) => {
    if (!s) return '—';
    return s.charAt(0).toUpperCase() + s.slice(1);
  };

  const recipientBadge = (s) => {
    if (s === 'sent') return 'badge-success';
    if (s === 'failed') return 'badge-danger';
    return 'badge-muted';
  };

  const total = counts.total || 0;
  const sent = counts.sent || 0;
  const failed = counts.failed || 0;
  const pending = counts.pending || 0;
  const processed = sent + failed;
  const percent = total > 0 ? Math.round((processed / total) * 100) : 0;
%>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= send.subject %></h1>
    <p class="page-subtitle">
      <a href="/admin/newsletter">&larr; Back to Newsletter</a>
    </p>
  </div>
  <div class="page-actions">
    <span class="badge <%= statusBadge(send.status) %>" style="font-size: 12px; padding: 6px 12px;">
      <%= statusLabel(send.status) %>
    </span>
    <% if (send.status === 'sending' || send.status === 'draft') { %>
      <form action="/admin/newsletter/<%= send.id %>/resume" method="POST" style="display:inline;">
        <button type="submit" class="btn btn-outline">Resume Sending</button>
      </form>
    <% } %>
  </div>
</div>

<%# ─── Progress card ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Progress</h3>

  <div class="nl-stats-grid">
    <div class="nl-stat">
      <div class="nl-stat-value"><%= total %></div>
      <div class="nl-stat-label">Recipients</div>
    </div>
    <div class="nl-stat nl-stat-success">
      <div class="nl-stat-value"><%= sent %></div>
      <div class="nl-stat-label">Sent</div>
    </div>
    <div class="nl-stat nl-stat-danger">
      <div class="nl-stat-value"><%= failed %></div>
      <div class="nl-stat-label">Failed</div>
    </div>
    <div class="nl-stat nl-stat-muted">
      <div class="nl-stat-value"><%= pending %></div>
      <div class="nl-stat-label">Pending</div>
    </div>
  </div>

  <div class="nl-progress">
    <div class="nl-progress-bar">
      <div class="nl-progress-fill" style="width: <%= percent %>%;"></div>
    </div>
    <div class="nl-progress-label">
      <%= processed %> of <%= total %> processed (<%= percent %>%)
    </div>
  </div>

  <div class="nl-timeline">
    <div class="nl-timeline-row">
      <span class="nl-timeline-label">Created</span>
      <span class="nl-timeline-value"><%= fmtDateTime(send.created_at) %></span>
    </div>
    <% if (send.started_at) { %>
      <div class="nl-timeline-row">
        <span class="nl-timeline-label">Started sending</span>
        <span class="nl-timeline-value"><%= fmtDateTime(send.started_at) %></span>
      </div>
    <% } %>
    <% if (send.completed_at) { %>
      <div class="nl-timeline-row">
        <span class="nl-timeline-label">Completed</span>
        <span class="nl-timeline-value"><%= fmtDateTime(send.completed_at) %></span>
      </div>
    <% } %>
  </div>

  <% if (send.status === 'sending') { %>
    <p class="text-muted" style="margin: 14px 0 0; font-size: 13px;">
      <strong>Tip:</strong> Refresh this page to see the latest progress. Sending happens in batches of 20 with a small delay between batches.
    </p>
  <% } %>
</div>

<%# ─── Content preview ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Message preview</h3>

  <details class="nl-preview-details" open>
    <summary class="nl-preview-summary">Show / hide rendered HTML</summary>
    <div class="nl-rendered">
      <%- send.body_html %>
    </div>
  </details>

  <% if (send.body_text) { %>
    <details class="nl-preview-details">
      <summary class="nl-preview-summary">Show / hide plain-text version</summary>
      <pre class="nl-text-preview"><%= send.body_text %></pre>
    </details>
  <% } %>
</div>

<%# ─── Recipient log ─── %>
<div class="admin-card" style="padding: 0; overflow: hidden;">
  <div style="padding: 20px 22px 12px;">
    <h3 class="admin-card-title" style="margin-bottom: 4px;">Recipient log</h3>
    <p class="text-muted" style="margin: 0; font-size: 13px;">
      Showing the most recent <%= recipients.length %> recipients.
    </p>
  </div>

  <% if (!recipients || recipients.length === 0) { %>
    <div class="empty-state" style="padding: 30px 20px;">
      No recipient log yet.
    </div>
  <% } else { %>

    <%# ─── Desktop table ─── %>
    <div class="admin-table-wrap hide-mobile" style="border: none; border-radius: 0;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Email</th>
            <th style="width: 110px;">Status</th>
            <th style="width: 170px;">Sent at</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          <% recipients.forEach((r) => { %>
            <tr>
              <td>
                <span style="word-break: break-all;"><%= r.email %></span>
              </td>
              <td>
                <span class="badge <%= recipientBadge(r.status) %>"><%= r.status %></span>
              </td>
              <td>
                <span style="font-size: 13px; color: #6c757d;">
                  <%= r.sent_at ? fmtDateTime(r.sent_at) : '—' %>
                </span>
              </td>
              <td>
                <% if (r.error_message) { %>
                  <span style="font-size: 12px; color: #721c24; word-break: break-word;"><%= r.error_message %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%# ─── Mobile cards ─── %>
    <div class="show-mobile" style="padding: 0 16px 16px;">
      <% recipients.forEach((r) => { %>
        <div class="nl-recipient-item">
          <div class="nl-recipient-head">
            <span class="nl-recipient-email"><%= r.email %></span>
            <span class="badge <%= recipientBadge(r.status) %>"><%= r.status %></span>
          </div>
          <% if (r.sent_at) { %>
            <div class="nl-recipient-meta">Sent <%= fmtDateTime(r.sent_at) %></div>
          <% } %>
          <% if (r.error_message) { %>
            <div class="nl-recipient-error"><%= r.error_message %></div>
          <% } %>
        </div>
      <% }); %>
    </div>

  <% } %>
</div>

<%# ─── Danger zone ─── %>
<div class="admin-card admin-card-danger">
  <h3 class="admin-card-title" style="color: #721c24;">Danger zone</h3>
  <p style="margin: 0 0 14px; font-size: 14px; color: #6c757d;">
    Deleting this campaign removes the record and the entire recipient log.
    Sent emails cannot be recalled.
  </p>
  <form action="/admin/newsletter/<%= send.id %>/delete" method="POST"
        onsubmit="return confirm('Delete this campaign and its recipient log? This cannot be undone.');">
    <button type="submit" class="btn btn-danger">Delete Campaign</button>
  </form>
</div>