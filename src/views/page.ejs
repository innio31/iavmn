<%
  // Split content into blocks on blank lines
  const blocks = (page.content || '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

  // Sub-heading detection: a short line without a trailing period,
  // or ending with a colon — treated as a heading.
  const isSubheading = (text) => {
    const t = text.trim();
    if (!t) return false;
    if (t.length > 80) return false;
    if (t.includes('\n')) return false;
    const endsWithColon = /:$/.test(t);
    const noTrailingPunct = !/[.!?,;]$/.test(t);
    return endsWithColon || noTrailingPunct;
  };
%>

<section class="page-hero">
  <div class="container">
    <h1><%= page.title %></h1>
    <% if (page.meta_description) { %>
      <p><%= page.meta_description %></p>
    <% } %>
  </div>
</section>

<section class="page-content-section">
  <div class="container container-narrow">
    <p class="profile-back">
      <a href="/">&larr; Back to Home</a>
    </p>

    <% if (blocks.length) { %>
      <article class="page-content">
        <% blocks.forEach((block) => { %>
          <% if (isSubheading(block)) { %>
            <h2 class="page-subheading"><%= block %></h2>
          <% } else { %>
            <p><%= block.replace(/\n/g, ' ') %></p>
          <% } %>
        <% }); %>
      </article>
    <% } else { %>
      <p class="text-muted">This page has no content yet.</p>
    <% } %>

    <div class="page-cta">
      <p>
        Have a question about this? <a href="/contact">Contact us &rarr;</a>
      </p>
    </div>
  </div>
</section>