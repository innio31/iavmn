<%
  var siteShort = (settings && settings.site_short_name) || appName || 'IAVMN';
%>

<div class="member-auth-wrap">
  <div class="member-auth-card">

    <div class="member-auth-head">
      <div class="member-auth-icon member-auth-icon-warn">⏱</div>
      <h1 class="member-auth-title">Link expired</h1>
      <p class="member-auth-sub">
        This password setup link has expired or is no longer valid.
      </p>
    </div>

    <div class="member-auth-warning">
      <strong>What happened?</strong>
      For your security, password setup and reset links expire after a short time.
      <% if (typeof email !== 'undefined' && email) { %>
        The link for <strong><%= email %></strong> can no longer be used.
      <% } %>
    </div>

    <p class="member-auth-sub" style="text-align: center; margin-bottom: 20px;">
      Don't worry — you can request a new link in a few seconds.
    </p>

    <p class="member-auth-cta">
      <a href="/member/forgot-password" class="btn btn-primary member-auth-btn-secondary">
        Request a New Link
      </a>
    </p>

    <p class="member-auth-footer">
      <a href="/member/login">&larr; Back to Login</a>
    </p>

  </div>
</div>