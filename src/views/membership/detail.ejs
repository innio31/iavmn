<%
  const paragraphs = (tier.description || '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

  const currencySymbol = (c) => {
    if (c === 'NGN') return '₦';
    if (c === 'USD') return '$';
    if (c === 'GBP') return '£';
    if (c === 'EUR') return '€';
    if (c === 'GHS') return '₵';
    if (c === 'KES') return 'KSh';
    if (c === 'ZAR') return 'R';
    return c + ' ';
  };

  const memFee = Number(tier.fee_amount || 0);
  const regFee = Number(globalFormFee || 20000);
  const total = memFee + regFee;
  
  const isQuote = memFee === 0;
  const sym = currencySymbol(tier.currency);
%>

<section class="page-hero">
  <div class="container">
    <h1><%= tier.name %></h1>
    <% if (tier.short_description) { %>
      <p><%= tier.short_description %></p>
    <% } %>
  </div>
</section>

<section class="tier-detail-section">
  <div class="container">
    <p class="profile-back">
      <a href="/membership">&larr; Back to Membership</a>
    </p>

    <div class="tier-detail-grid">

      <div class="tier-detail-body">
        <% if (tier.icon) { %>
          <div class="tier-detail-icon"><%= tier.icon %></div>
        <% } %>

        <h2 class="tier-detail-title">About this membership</h2>

        <% if (paragraphs.length) { %>
          <div class="tier-detail-text">
            <% paragraphs.forEach((para) => { %>
              <p><%= para.replace(/\n/g, ' ') %></p>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted">Full details coming soon.</p>
        <% } %>
      </div>

      <aside class="tier-detail-sidebar">
        <div class="tier-sidebar-card">
          <h3 class="tier-sidebar-title">Application</h3>

          <% if (isQuote) { %>
            <div class="tier-sidebar-fee">
              <span class="tier-sidebar-fee-label">Fee</span>
              <span class="tier-sidebar-fee-value" style="font-size: 18px;">On enquiry</span>
            </div>
            <p class="text-muted" style="font-size: 13px; margin: 0 0 14px; line-height: 1.5;">
              This tier is priced based on your organization's profile. Complete the application
              and our team will send you a custom quote.
            </p>
          <% } else { %>
            <div class="tier-sidebar-fee-details">
              <div class="tier-sidebar-fee-row">
                <span>Registration form</span>
                <span><%= sym %> <%= regFee.toLocaleString() %></span>
              </div>
              <div class="tier-sidebar-fee-row">
                <span>Membership fee</span>
                <span><%= sym %> <%= memFee.toLocaleString() %></span>
              </div>
              <div class="tier-sidebar-fee-row tier-sidebar-fee-row-total">
                <span>Total</span>
                <span><%= sym %> <%= total.toLocaleString() %></span>
              </div>
            </div>
          <% } %>

          <a href="/membership/<%= tier.slug %>/apply" class="btn btn-primary btn-block">
            <%= isQuote ? 'Apply for a Quote' : 'Apply for this tier' %>
          </a>

          <p class="tier-sidebar-note">
            You'll be asked to provide your details and upload a CV and passport photo.
          </p>
        </div>

        <div class="tier-sidebar-card tier-sidebar-help">
          <h3 class="tier-sidebar-title">Need help?</h3>
          <p class="tier-sidebar-text">
            Not sure if this is the right category?
            <a href="/contact">Contact us</a> and we'll guide you.
          </p>
          <p class="tier-sidebar-text">
            <a href="/membership">View all membership tiers &rarr;</a>
          </p>
        </div>
      </aside>

    </div>
  </div>
</section>