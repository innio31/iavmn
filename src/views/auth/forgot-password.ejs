<%
  var siteShort = (settings && settings.site_short_name) || appName || 'IAVMN';
%>

<% if (sent) { %>

  <div class="auth-icon-wrap auth-icon-success">✉</div>
  <h1 class="auth-title">Check your email</h1>
  <p class="auth-subtitle">
    If an admin account exists with that email, we've sent a password reset link.
  </p>

  <div class="auth-info-box">
    <strong>What to do next:</strong>
    Open the email from <%= siteShort %> and click the reset link. The link expires in 1 hour.
  </div>

  <p class="auth-links">
    Didn't get the email? Check your spam folder, or
    <a href="/forgot-password">try again</a>.
  </p>

  <p class="auth-links">
    <a href="/login">&larr; Back to Login</a>
  </p>

<% } else { %>

  <div class="auth-icon-wrap">🔑</div>
  <h1 class="auth-title">Forgot your password?</h1>
  <p class="auth-subtitle">
    Enter the email address you use for your admin account, and we'll send you a link to reset your password.
  </p>

  <% if (errors && errors.length) { %>
    <div class="auth-errors">
      <strong>Please fix the following:</strong>
      <ul>
        <% errors.forEach((e) => { %>
          <li><%= e.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/forgot-password" method="POST" class="auth-form" novalidate>
    <div class="form-row">
      <label for="email">Email address</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= form.email %>"
        required
        maxlength="180"
        autocomplete="email"
        inputmode="email"
        autofocus>
    </div>

    <button type="submit" class="btn btn-primary">Send Reset Link</button>
  </form>

  <p class="auth-links">
    <a href="/login">&larr; Back to Login</a>
  </p>

<% } %>