<%
  const fmtDate = (dt) => {
    if (!dt) return '—';
    const d = new Date(dt);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  };

  const fmtDateTime = (dt) => {
    if (!dt) return '—';
    const d = new Date(dt);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  };

  const statusBadge = (s) => {
    if (s === 'active') return 'badge-success';
    if (s === 'pending') return 'badge-info';
    if (s === 'suspended') return 'badge-warning';
    if (s === 'expired') return 'badge-danger';
    if (s === 'cancelled') return 'badge-muted';
    return 'badge-muted';
  };

  const statusLabel = (s) => {
    if (!s) return '—';
    return s.charAt(0).toUpperCase() + s.slice(1);
  };

  const days = member.expires_at
    ? Math.ceil((new Date(member.expires_at).getTime() - Date.now()) / (1000 * 60 * 60 * 24))
    : null;
  const isExpired = days !== null && days <= 0;
  const isExpiringSoon = days !== null && days > 0 && days <= 60;
%>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= member.full_name %></h1>
    <p class="page-subtitle">
      <code class="page-slug-code" style="font-size: 13px;"><%= member.member_number %></code>
      &middot; <a href="/admin/members">&larr; Back to Members</a>
    </p>
  </div>
  <div class="page-actions">
    <span class="badge <%= statusBadge(member.status) %>" style="font-size: 12px; padding: 6px 12px; text-transform: capitalize;">
      <%= statusLabel(member.status) %>
    </span>
    <% if (!member.is_verified) { %>
      <span class="badge badge-warning" style="font-size: 12px; padding: 6px 12px;">Not verified</span>
    <% } %>
  </div>
</div>

<% if (isExpired && member.status === 'active') { %>
  <div class="admin-card" style="border-color: #f5c6cb; background: #fff9f9;">
    <strong style="color: #721c24;">Membership expired</strong>
    <p style="margin: 6px 0 0; font-size: 14px; color: #721c24;">
      This member's membership expired <%= Math.abs(days) %> day<%= Math.abs(days) === 1 ? '' : 's' %> ago
      (on <%= fmtDate(member.expires_at) %>). Consider renewing or suspending their account.
    </p>
  </div>
<% } else if (isExpiringSoon) { %>
  <div class="admin-card" style="border-color: #ffeeba; background: #fffdf6;">
    <strong style="color: #856404;">Expiring soon</strong>
    <p style="margin: 6px 0 0; font-size: 14px; color: #856404;">
      This membership expires in <%= days %> day<%= days === 1 ? '' : 's' %>
      (on <%= fmtDate(member.expires_at) %>).
    </p>
  </div>
<% } %>

<%# ─── Summary card ─── %>
<div class="admin-card">
  <div class="app-detail-head">
    <div class="app-detail-avatar">
      <% if (member.photo_path) { %>
        <img src="<%= member.photo_path %>" alt="<%= member.full_name %>" class="app-photo">
      <% } else { %>
        <div class="app-photo app-photo-placeholder">
          <%= (member.full_name || '?').charAt(0).toUpperCase() %>
        </div>
      <% } %>
    </div>
    <div class="app-detail-meta">
      <h2 class="app-detail-name"><%= member.full_name %></h2>
      <div class="app-detail-tier">
        <strong>Tier:</strong> <%= member.tier_name || '—' %>
      </div>
      <div class="app-detail-date">
        Member since <%= fmtDate(member.joined_at) %>
        <% if (member.expires_at) { %>
          &middot; Expires <%= fmtDate(member.expires_at) %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="app-detail-grid">
    <div class="app-detail-row">
      <div class="app-detail-label">Email</div>
      <div class="app-detail-value">
        <a href="mailto:<%= member.email %>"><%= member.email %></a>
      </div>
    </div>

    <% if (member.phone) { %>
      <div class="app-detail-row">
        <div class="app-detail-label">Phone</div>
        <div class="app-detail-value">
          <a href="tel:<%= member.phone.replace(/\s+/g, '') %>"><%= member.phone %></a>
        </div>
      </div>
    <% } %>

    <% if (member.address) { %>
      <div class="app-detail-row">
        <div class="app-detail-label">Address</div>
        <div class="app-detail-value"><%= member.address %></div>
      </div>
    <% } %>

    <% if (member.employer) { %>
      <div class="app-detail-row">
        <div class="app-detail-label">Employer</div>
        <div class="app-detail-value"><%= member.employer %></div>
      </div>
    <% } %>

    <% if (member.years_experience !== null && member.years_experience !== undefined) { %>
      <div class="app-detail-row">
        <div class="app-detail-label">Experience</div>
        <div class="app-detail-value"><%= member.years_experience %> year<%= member.years_experience === 1 ? '' : 's' %></div>
      </div>
    <% } %>
  </div>

  <% if (member.qualifications) { %>
    <div class="app-qualifications">
      <div class="app-detail-label">Qualifications</div>
      <div class="app-qualifications-body"><%= member.qualifications %></div>
    </div>
  <% } %>
</div>

<%# ─── Account info ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Account</h3>
  <div class="app-detail-grid">
    <div class="app-detail-row">
      <div class="app-detail-label">Verified</div>
      <div class="app-detail-value">
        <% if (member.is_verified) { %>
          <span class="badge badge-success">Yes</span>
          <% if (member.verified_at) { %>
            <span style="font-size: 13px; color: #6c757d; margin-left: 6px;">on <%= fmtDate(member.verified_at) %></span>
          <% } %>
        <% } else { %>
          <span class="badge badge-warning">No</span>
        <% } %>
      </div>
    </div>
    <div class="app-detail-row">
      <div class="app-detail-label">Last login</div>
      <div class="app-detail-value">
        <%= member.last_login_at ? fmtDateTime(member.last_login_at) : 'Never' %>
      </div>
    </div>
    <div class="app-detail-row">
      <div class="app-detail-label">Created</div>
      <div class="app-detail-value"><%= fmtDateTime(member.created_at) %></div>
    </div>
    <div class="app-detail-row">
      <div class="app-detail-label">Member ID</div>
      <div class="app-detail-value"><code class="page-slug-code">#<%= member.id %></code></div>
    </div>
  </div>
</div>

<%# ─── Linked application ─── %>
<% if (typeof application !== 'undefined' && application) { %>
  <div class="admin-card">
    <h3 class="admin-card-title">Linked Application</h3>
    <p style="margin: 0 0 14px; font-size: 14px; color: #6c757d;">
      This member was created from the following application.
    </p>
    <div class="app-detail-grid">
      <div class="app-detail-row">
        <div class="app-detail-label">Reference</div>
        <div class="app-detail-value"><code class="page-slug-code"><%= application.reference %></code></div>
      </div>
      <div class="app-detail-row">
        <div class="app-detail-label">Applied</div>
        <div class="app-detail-value"><%= fmtDate(application.created_at) %></div>
      </div>
      <div class="app-detail-row">
        <div class="app-detail-label">Payment</div>
        <div class="app-detail-value" style="text-transform: capitalize;"><%= application.payment_status %></div>
      </div>
    </div>
    <div style="margin-top: 14px;">
      <a href="/admin/applications/<%= application.id %>" class="btn btn-sm btn-outline">
        View original application &rarr;
      </a>
    </div>
  </div>
<% } %>

<%# ─── Edit card ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Edit membership</h3>
  <p class="text-muted" style="margin: 0 0 18px; font-size: 14px;">
    Change the tier, status, or expiry. Members can only edit their own profile fields (name, phone, address, employer, qualifications).
  </p>

  <form action="/admin/members/<%= member.id %>" method="POST">
    <div class="form-row form-row-split">
      <div>
        <label for="tier_id">Tier <span style="color: #c0392b;">*</span></label>
        <select id="tier_id" name="tier_id" required>
          <% tierOptions.forEach((t) => { %>
            <option value="<%= t.id %>" <%= member.tier_id === t.id ? 'selected' : '' %>>
              <%= t.name %><%= t.is_active ? '' : ' (hidden)' %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="status">Status <span style="color: #c0392b;">*</span></label>
        <select id="status" name="status" required>
          <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="pending" <%= member.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="suspended" <%= member.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
          <option value="expired" <%= member.status === 'expired' ? 'selected' : '' %>>Expired</option>
          <option value="cancelled" <%= member.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <label for="expires_at">Expiry date &amp; time</label>
      <input
        type="datetime-local"
        id="expires_at"
        name="expires_at"
        value="<%= expiresAtInput %>">
      <span class="form-hint">
        The date the membership becomes invalid. Leave blank for no expiry.
      </span>
    </div>

    <div class="form-row">
      <label for="notes">Internal notes</label>
      <textarea
        id="notes"
        name="notes"
        rows="4"
        maxlength="2000"
        placeholder="Notes visible only to admins."><%= member.notes || '' %></textarea>
    </div>

    <div class="settings-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/admin/members" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%# ─── Quick status actions ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Quick status changes</h3>
  <p class="text-muted" style="margin: 0 0 14px; font-size: 14px;">
    Fast actions for common scenarios. You can also use the Edit form above.
  </p>

  <div class="row-actions">
    <% if (member.status !== 'active') { %>
      <form action="/admin/members/<%= member.id %>/status" method="POST" style="display:inline;">
        <input type="hidden" name="next_status" value="active">
        <button type="submit" class="btn btn-sm btn-outline">Activate</button>
      </form>
    <% } %>

    <% if (member.status !== 'suspended') { %>
      <form action="/admin/members/<%= member.id %>/status" method="POST" style="display:inline;"
            onsubmit="return confirm('Suspend this member? They will not be able to log in.');">
        <input type="hidden" name="next_status" value="suspended">
        <button type="submit" class="btn btn-sm btn-outline">Suspend</button>
      </form>
    <% } %>

    <% if (member.status !== 'expired') { %>
      <form action="/admin/members/<%= member.id %>/status" method="POST" style="display:inline;"
            onsubmit="return confirm('Mark this membership as expired?');">
        <input type="hidden" name="next_status" value="expired">
        <button type="submit" class="btn btn-sm btn-outline">Mark expired</button>
      </form>
    <% } %>

    <a href="/verify/<%= encodeURIComponent(member.member_number) %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline">
      Public verification page
    </a>
  </div>
</div>

<%# ─── Password actions ─── %>
<div class="admin-card">
  <h3 class="admin-card-title">Password</h3>
  <p class="text-muted" style="margin: 0 0 18px; font-size: 14px;">
    Send the member a secure link, or set a password directly. Use direct set only for troubleshooting —
    the member will not be notified, so you must share it securely.
  </p>

  <div style="margin-bottom: 22px;">
    <form action="/admin/members/<%= member.id %>/send-reset" method="POST" style="display:inline;"
          onsubmit="return confirm('Send a password reset link to <%= member.email %>?');">
      <button type="submit" class="btn btn-outline">
        <%= member.is_verified ? 'Send reset link' : 'Send welcome email' %>
      </button>
    </form>
  </div>

  <form action="/admin/members/<%= member.id %>/password" method="POST">
    <div class="form-row">
      <label for="new_password">Set password directly</label>
      <input
        type="text"
        id="new_password"
        name="new_password"
        required
        minlength="8"
        maxlength="100"
        autocomplete="off"
        placeholder="Minimum 8 characters">
      <span class="form-hint">
        The new password will be visible in the field above. Copy it and share with the member via a secure channel.
      </span>
    </div>
    <div class="settings-actions" style="margin-top: 8px;">
      <button type="submit" class="btn btn-outline"
              onclick="return confirm('Set this password for <%= member.full_name %>? They will not be notified.');">
        Set Password
      </button>
    </div>
  </form>
</div>

<%# ─── Danger zone ─── %>
<div class="admin-card admin-card-danger">
  <h3 class="admin-card-title" style="color: #721c24;">Danger zone</h3>
  <p style="margin: 0 0 14px; font-size: 14px; color: #6c757d;">
    Deleting this member is permanent. Their application and payment records are preserved,
    but the member account and portal access will be lost.
  </p>
  <form action="/admin/members/<%= member.id %>/delete" method="POST"
        onsubmit="return confirm('Delete this member? This cannot be undone. The account and portal access will be lost.');">
    <button type="submit" class="btn btn-danger">Delete Member</button>
  </form>
</div>