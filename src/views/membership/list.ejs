<%
  const currencySymbol = (c) => {
    if (c === 'NGN') return '₦';
    if (c === 'USD') return '$';
    if (c === 'GBP') return '£';
    if (c === 'EUR') return '€';
    if (c === 'GHS') return '₵';
    if (c === 'KES') return 'KSh';
    if (c === 'ZAR') return 'R';
    return c + ' ';
  };
%>

<section class="page-hero">
  <div class="container">
    <h1>Membership</h1>
    <p>Choose the category that matches your professional stage. Join a growing community of asset and value management professionals.</p>
  </div>
</section>

<section class="membership-section">
  <div class="container">
    <% if (!tiers || tiers.length === 0) { %>
      <div class="empty-public">
        <p>Membership categories are being updated. Please check back soon.</p>
      </div>
    <% } else { %>
      <div class="tiers-grid">
        <% tiers.forEach((t) => { %>
          <%
            const reg = Number(t.registration_fee || 0);
            const mem = Number(t.fee_amount || 0);
            const total = reg + mem;
            const isQuote = total === 0;
          %>
          <div class="tier-card">
            <% if (t.icon) { %>
              <div class="tier-card-icon"><%= t.icon %></div>
            <% } %>

            <h3 class="tier-card-name"><%= t.name %></h3>

            <% if (t.short_description) { %>
              <p class="tier-card-desc"><%= t.short_description %></p>
            <% } %>

            <div class="tier-card-fee">
              <% if (isQuote) { %>
                <span class="tier-fee-label">Fee</span>
                <span class="tier-fee-amount" style="font-size: 15px;">Fee on enquiry</span>
              <% } else { %>
                <span class="tier-fee-label">Total fee</span>
                <span class="tier-fee-amount"><%= currencySymbol(t.currency) %> <%= total.toLocaleString() %></span>
              <% } %>
            </div>

            <div class="tier-card-actions">
              <a href="/membership/<%= t.slug %>" class="btn btn-outline">Learn More</a>
              <a href="/membership/<%= t.slug %>/apply" class="btn btn-primary">Apply Now</a>
            </div>
          </div>
        <% }); %>
      </div>

      <p class="membership-note">
        Not sure which category fits you? <a href="/contact">Contact us</a> and we'll help you decide.
      </p>
    <% } %>
  </div>
</section>