<div class="page-header">
  <div>
    <h1 class="page-title">Contact Messages</h1>
    <p class="page-subtitle">
      <%= totalCount %> total
      <% if (unreadCount > 0) { %>
        &middot; <strong style="color: #c0392b;"><%= unreadCount %> unread</strong>
      <% } %>
    </p>
  </div>
  <div class="page-actions">
    <% if (unreadCount > 0) { %>
      <form action="/admin/messages/mark-all-read" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-outline">Mark all as read</button>
      </form>
    <% } %>
  </div>
</div>

<nav class="filter-tabs">
  <a href="/admin/messages" class="filter-tab <%= filter === 'all' ? 'active' : '' %>">
    All <span class="filter-tab-count"><%= totalCount %></span>
  </a>
  <a href="/admin/messages?filter=unread" class="filter-tab <%= filter === 'unread' ? 'active' : '' %>">
    Unread <% if (unreadCount > 0) { %><span class="filter-tab-count filter-tab-count-danger"><%= unreadCount %></span><% } %>
  </a>
</nav>

<% if (!messages || messages.length === 0) { %>
  <div class="admin-card">
    <div class="empty-state">
      <p>
        <% if (filter === 'unread') { %>
          No unread messages. Nice work!
        <% } else { %>
          No messages yet.
        <% } %>
      </p>
      <p class="text-muted" style="font-size: 14px;">
        Messages sent through the public contact form will appear here.
      </p>
    </div>
  </div>
<% } else { %>

  <%# ─── Desktop / tablet: table ─── %>
  <div class="admin-table-wrap hide-mobile">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 32px;"></th>
          <th>From</th>
          <th>Subject &amp; Preview</th>
          <th style="width: 140px;">Received</th>
          <th style="width: 200px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% messages.forEach((m) => { %>
          <tr class="<%= !m.is_read ? 'row-unread' : '' %>">
            <td>
              <% if (!m.is_read) { %>
                <span class="unread-dot" title="Unread"></span>
              <% } %>
            </td>
            <td>
              <strong><%= m.name %></strong>
              <br><a href="mailto:<%= m.email %>" style="font-size: 13px; color: #25573f;"><%= m.email %></a>
              <% if (m.phone) { %>
                <br><span class="text-muted" style="font-size: 12px;"><%= m.phone %></span>
              <% } %>
            </td>
            <td>
              <% if (m.subject) { %>
                <strong><%= m.subject %></strong><br>
              <% } %>
              <span class="text-muted" style="font-size: 13px;">
                <%= m.message.length > 120 ? m.message.slice(0, 120) + '…' : m.message %>
              </span>
            </td>
            <td>
              <span style="font-size: 13px; color: #6c757d;">
                <%= new Date(m.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
            </td>
            <td>
              <div class="row-actions">
                <a href="/admin/messages/<%= m.id %>" class="btn btn-sm btn-outline">Read</a>

                <form action="/admin/messages/<%= m.id %>/toggle" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-outline">
                    <%= m.is_read ? 'Mark unread' : 'Mark read' %>
                  </button>
                </form>

                <form action="/admin/messages/<%= m.id %>/delete" method="POST" style="display:inline;"
                      onsubmit="return confirm('Delete this message? This cannot be undone.');">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <%# ─── Mobile: cards ─── %>
  <div class="show-mobile">
    <% messages.forEach((m) => { %>
      <div class="admin-card <%= !m.is_read ? 'card-unread' : '' %>">
        <div style="margin-bottom: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <% if (!m.is_read) { %>
              <span class="unread-dot"></span>
            <% } %>
            <strong style="word-break: break-word;"><%= m.name %></strong>
          </div>
          <a href="mailto:<%= m.email %>" style="font-size: 13px; color: #25573f; word-break: break-all; display: block; margin-bottom: 4px;">
            <%= m.email %>
          </a>
          <% if (m.phone) { %>
            <div class="text-muted" style="font-size: 12px; margin-bottom: 8px;"><%= m.phone %></div>
          <% } %>
          <% if (m.subject) { %>
            <div style="font-weight: 600; margin: 8px 0 4px;"><%= m.subject %></div>
          <% } %>
          <div class="text-muted" style="font-size: 13px; line-height: 1.5;">
            <%= m.message.length > 160 ? m.message.slice(0, 160) + '…' : m.message %>
          </div>
          <div class="mobile-card-meta" style="margin-top: 10px;">
            <span><%= new Date(m.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
            <span><%= new Date(m.created_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
        </div>

        <div class="mobile-card-actions">
          <a href="/admin/messages/<%= m.id %>" class="btn btn-sm btn-outline">Read</a>

          <form action="/admin/messages/<%= m.id %>/toggle" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-sm btn-outline">
              <%= m.is_read ? 'Mark unread' : 'Mark read' %>
            </button>
          </form>

          <form action="/admin/messages/<%= m.id %>/delete" method="POST" style="display:inline;"
                onsubmit="return confirm('Delete this message? This cannot be undone.');">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>

<% } %>