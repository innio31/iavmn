<%
  var siteShort = (settings && settings.site_short_name) || appName || 'IAVMN';
%>

<div class="member-auth-wrap">
  <div class="member-auth-card">

    <div class="member-auth-head">
      <div class="member-auth-icon">🔐</div>
      <h1 class="member-auth-title">Member Login</h1>
      <p class="member-auth-sub">Sign in to access your member dashboard.</p>
    </div>

    <% if (errors && errors.length) { %>
      <div class="member-auth-errors">
        <strong>Please fix the following:</strong>
        <ul>
          <% errors.forEach((e) => { %>
            <li><%= e.msg %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/member/login" method="POST" class="member-auth-form" novalidate>
      <% if (typeof next !== 'undefined' && next) { %>
        <input type="hidden" name="next" value="<%= next %>">
      <% } %>

      <div class="form-row">
        <label for="email">Email address</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= form.email %>"
          required
          maxlength="180"
          autocomplete="email"
          inputmode="email"
          autofocus>
      </div>

      <div class="form-row">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          maxlength="100"
          autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary member-auth-btn">Log In</button>
    </form>

    <div class="member-auth-links">
      <a href="/member/forgot-password">Forgot your password?</a>
    </div>

    <div class="member-auth-divider">
      <span>New to IAVMN?</span>
    </div>

    <p class="member-auth-cta">
      <a href="/membership" class="btn btn-outline member-auth-btn-secondary">View Membership Options</a>
    </p>

    <p class="member-auth-footer">
      <a href="/">&larr; Back to main site</a>
    </p>

  </div>
</div>