<%
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var appUrl = appUrl || (settings && settings.app_url) || 'https://iavmn.org.ng';
  var contactEmail = (settings && settings.contact_email) || 'info@iavmn.org';
  var contactAddress = (settings && settings.contact_address) || null;

  var recipientEmail = (subscriber && subscriber.email) || '';
  var testMode = (typeof isTest !== 'undefined' && isTest) ? true : false;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject %></title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 620px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Test badge -->
          <% if (testMode) { %>
            <tr>
              <td style="background-color: #fff3cd; color: #856404; padding: 10px 20px; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: 0.5px;">
                ⚠ TEST SEND — this is a preview, not a real broadcast
              </td>
            </tr>
          <% } %>

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 26px 28px; text-align: center;">
              <div style="font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 12px; color: rgba(255, 255, 255, 0.8); margin-top: 4px; letter-spacing: 0.5px;">
                <%= siteName %>
              </div>
            </td>
          </tr>

          <!-- Subject as heading -->
          <tr>
            <td style="padding: 32px 32px 8px;">
              <h1 style="margin: 0; font-size: 22px; color: #25573f; line-height: 1.35; font-weight: 700;">
                <%= subject %>
              </h1>
            </td>
          </tr>

          <!-- Campaign body (admin-authored HTML, rendered as-is) -->
          <tr>
            <td style="padding: 16px 32px 32px; font-size: 15px; line-height: 1.75; color: #212529;">
              <%- bodyHtml %>
            </td>
          </tr>

          <!-- CTA: visit site -->
          <tr>
            <td style="padding: 0 32px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #25573f; border-radius: 6px;">
                    <a href="<%= appUrl %>"
                       style="display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">
                      Visit <%= siteShort %>
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 0 32px;">
              <hr style="border: none; border-top: 1px solid #dfeae8; margin: 0;">
            </td>
          </tr>

          <!-- Contact info -->
          <tr>
            <td style="padding: 20px 32px 12px;">
              <p style="margin: 0 0 6px; font-size: 13px; color: #6c757d; line-height: 1.6;">
                <strong style="color: #25573f;">Stay connected</strong>
              </p>
              <p style="margin: 0 0 6px; font-size: 13px; color: #6c757d; line-height: 1.6;">
                Email:
                <a href="mailto:<%= contactEmail %>" style="color: #25573f; text-decoration: none; font-weight: 600;">
                  <%= contactEmail %>
                </a>
              </p>
              <% if (contactAddress) { %>
                <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.6;">
                  <%= contactAddress %>
                </p>
              <% } %>
            </td>
          </tr>

          <!-- Footer with unsubscribe -->
          <tr>
            <td style="background-color: #edf3f2; padding: 22px 32px; border-top: 1px solid #dfeae8; text-align: center;">
              <p style="margin: 0 0 10px; font-size: 12px; color: #6c757d; line-height: 1.6;">
                You're receiving this email because <strong><%= recipientEmail %></strong> subscribed to our newsletter.
              </p>
              <p style="margin: 0 0 10px; font-size: 12px;">
                <a href="<%= unsubscribeUrl %>" style="color: #25573f; text-decoration: underline; font-weight: 600;">
                  Unsubscribe from this list
                </a>
              </p>
              <p style="margin: 0; font-size: 11px; color: #adb5bd;">
                &copy; <%= new Date().getFullYear() %> <%= siteName %>
              </p>
            </td>
          </tr>

        </table>

        <!-- Preheader (hidden) -->
        <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #edf3f2;">
          A newsletter from <%= siteName %>.
        </div>

      </td>
    </tr>
  </table>

</body>
</html>