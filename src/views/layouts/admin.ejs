<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title + ' | Admin | ' + appName : 'Admin | ' + appName %></title>

  <%
    var adminFavicon = (settings && settings.site_favicon_path) || (settings && settings.site_logo_path) || null;
    var adminTheme = (settings && settings.pwa_theme_color) || '#25573f';
  %>
  <meta name="theme-color" content="<%= adminTheme %>">
  <% if (adminFavicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= adminFavicon %>">
    <link rel="apple-touch-icon" href="<%= adminFavicon %>">
  <% } else { %>
    <link rel="icon" type="image/x-icon" href="/uploads/branding/favicon.ico">
  <% } %>

  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/responsive-helpers.css">
</head>
<body class="admin-body">

  <%
    var userRole = currentUser ? currentUser.role_name : 'guest';
    var canManageContent = ['super_admin','admin','editor'].indexOf(userRole) !== -1;
    var canManageApps    = ['super_admin','admin','membership_officer'].indexOf(userRole) !== -1;
    var isSuperAdmin     = userRole === 'super_admin';

    var counts = (typeof locals !== 'undefined' && locals.counts) ? locals.counts : {};
    var unreadMessages = counts.unreadMessages || 0;
    var appsActionable = counts.applicationsActionable || 0;

    var sidebarItems = [
      { href: '/admin',              label: 'Dashboard',           icon: '⌂', show: true,                                    badge: 0 },
      { href: '/admin/settings',     label: 'Settings',            icon: '⚙', show: canManageContent,                       badge: 0 },
      { href: '/admin/hero',         label: 'Hero Slides',         icon: '▤', show: canManageContent,                       badge: 0 },
      { href: '/admin/tiers',        label: 'Membership Tiers',    icon: '★', show: canManageContent,                       badge: 0 },
      { href: '/admin/council',      label: 'Council Members',     icon: '☺', show: canManageContent,                       badge: 0 },
      { href: '/admin/pages',        label: 'Pages',               icon: '▦', show: canManageContent,                       badge: 0 },
      { href: '/admin/faqs',         label: 'FAQs',                icon: '?', show: canManageContent,                       badge: 0 },
      { href: '/admin/testimonials', label: 'Testimonials',        icon: '“', show: canManageContent,                       badge: 0 },
      { href: '/admin/posts',        label: 'Posts',               icon: '✎', show: canManageContent,                       badge: 0 },
      { href: '/admin/applications', label: 'Applications',        icon: '✔', show: canManageApps,                          badge: appsActionable },
      { href: '/admin/members',      label: 'Members',             icon: '☰', show: canManageApps,                          badge: 0 },
      { href: '/admin/subscribers',  label: 'Subscribers',         icon: '@', show: canManageContent,                       badge: 0 },
      { href: '/admin/newsletter',   label: 'Newsletter',          icon: '✉', show: canManageContent,                       badge: 0 },
      { href: '/admin/messages',     label: 'Contact Messages',    icon: '✉', show: canManageContent,                       badge: unreadMessages },
      { href: '/admin/users',        label: 'Admin Users',         icon: '⚿', show: isSuperAdmin,                           badge: 0 },
    ].filter(function (i) { return i.show; });

    var currentPathLocal = currentPath || '';
    var isActive = function (href) {
      if (href === '/admin') return currentPathLocal === '/admin';
      return currentPathLocal === href || currentPathLocal.indexOf(href + '/') === 0;
    };
  %>

  <div class="admin-shell">

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="admin-sidebar-header">
        <a href="/admin" class="admin-brand">
          <% if (settings && settings.site_logo_path) { %>
            <img src="<%= settings.site_logo_path %>" alt="<%= settings.site_name || appName %>" class="admin-brand-img">
          <% } else { %>
            <strong><%= (settings && settings.site_short_name) || appName %></strong>
          <% } %>
        </a>
        <button type="button" class="admin-sidebar-close" aria-label="Close menu" onclick="document.body.classList.remove('admin-nav-open')">
          &times;
        </button>
      </div>

      <nav class="admin-nav">
        <% sidebarItems.forEach(function (item) { %>
          <a href="<%= item.href %>" class="admin-nav-item <%= isActive(item.href) ? 'active' : '' %>">
            <span class="admin-nav-icon" aria-hidden="true"><%= item.icon %></span>
            <span class="admin-nav-label"><%= item.label %></span>
            <% if (item.badge > 0) { %>
              <span class="admin-nav-badge"><%= item.badge %></span>
            <% } %>
          </a>
        <% }); %>
      </nav>

      <div class="admin-sidebar-footer">
        <a href="/" class="admin-nav-item" target="_blank" rel="noopener">
          <span class="admin-nav-icon" aria-hidden="true">↗</span>
          <span class="admin-nav-label">View Site</span>
        </a>
        <form action="/logout" method="POST" class="admin-logout-form">
          <button type="submit" class="admin-nav-item admin-nav-button">
            <span class="admin-nav-icon" aria-hidden="true">⎋</span>
            <span class="admin-nav-label">Log Out</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Backdrop for mobile -->
    <div class="admin-backdrop" onclick="document.body.classList.remove('admin-nav-open')"></div>

    <!-- Main column -->
    <div class="admin-main">

      <header class="admin-topbar">
        <button type="button" class="admin-menu-btn" aria-label="Open menu" onclick="document.body.classList.add('admin-nav-open')">
          &#9776;
        </button>
        <div class="admin-topbar-title">
          <%= typeof title !== 'undefined' ? title : 'Admin' %>
        </div>
        <%# Connection status pill is inserted here by admin-events.js %>
        <div class="admin-topbar-user">
          <span class="admin-user-name hide-mobile"><%= currentUser ? currentUser.name : '' %></span>
          <span class="admin-user-role"><%= currentUser ? currentUser.role_name.replace('_', ' ') : '' %></span>
        </div>
      </header>

      <% if (typeof flash !== 'undefined' && Object.keys(flash).length > 0) { %>
        <div class="admin-flash">
          <% ['success', 'error', 'info', 'warning'].forEach(function (type) { %>
            <% if (flash[type]) { %>
              <% flash[type].forEach(function (msg) { %>
                <div class="flash flash-<%= type %>"><%= msg %></div>
              <% }); %>
            <% } %>
          <% }); %>
        </div>
      <% } %>

      <main class="admin-content">
        <%- body %>
      </main>

    </div>

  </div>

  <%# ─── Real-time notifications (SSE) ─── %>
  <script src="/js/admin-events.js" defer></script>

</body>
</html>