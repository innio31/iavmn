<%
  var siteShort = (settings && settings.site_short_name) || appName || 'IAVMN';
%>

<div class="member-auth-wrap">
  <div class="member-auth-card">

    <% if (sent) { %>

      <%# ─── Success state ─── %>
      <div class="member-auth-head">
        <div class="member-auth-icon">✉</div>
        <h1 class="member-auth-title">Check your email</h1>
        <p class="member-auth-sub">
          If an account exists with that email, we've sent a password reset link.
        </p>
      </div>

      <div class="member-auth-info">
        <strong>What to do next:</strong>
        Open the email from <%= siteShort %> and click the reset link. The link expires in 1 hour.
      </div>

      <p class="member-auth-sub" style="text-align: center; margin-bottom: 20px;">
        Didn't get the email? Check your spam folder, or
        <a href="/member/forgot-password" style="color: #25573f; font-weight: 600;">try again</a>.
      </p>

      <p class="member-auth-cta">
        <a href="/member/login" class="btn btn-outline member-auth-btn-secondary">Back to Login</a>
      </p>

    <% } else { %>

      <%# ─── Form state ─── %>
      <div class="member-auth-head">
        <div class="member-auth-icon">🔑</div>
        <h1 class="member-auth-title">Forgot your password?</h1>
        <p class="member-auth-sub">
          Enter the email address you used to register, and we'll send you a link to reset your password.
        </p>
      </div>

      <% if (errors && errors.length) { %>
        <div class="member-auth-errors">
          <strong>Please fix the following:</strong>
          <ul>
            <% errors.forEach((e) => { %>
              <li><%= e.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/member/forgot-password" method="POST" class="member-auth-form" novalidate>
        <div class="form-row">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= form.email %>"
            required
            maxlength="180"
            autocomplete="email"
            inputmode="email"
            autofocus>
        </div>

        <button type="submit" class="btn btn-primary member-auth-btn">Send Reset Link</button>
      </form>

      <p class="member-auth-footer" style="margin-top: 24px;">
        <a href="/member/login">&larr; Back to Login</a>
      </p>

    <% } %>

  </div>
</div>