<%
  const phone     = settings.contact_phone || null;
  const phoneAlt  = settings.contact_phone_alt || null;
  const email     = settings.contact_email || null;
  const address   = settings.contact_address || null;
  const hours     = settings.contact_hours || null;

  const hasContactInfo = phone || phoneAlt || email || address || hours;
%>

<section class="page-hero">
  <div class="container">
    <h1>Contact Us</h1>
    <p>We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>
  </div>
</section>

<section class="contact-section">
  <div class="container">

    <% if (hasContactInfo) { %>
      <div class="contact-info-grid">
        <% if (address) { %>
          <div class="contact-info-card">
            <div class="contact-info-icon">📍</div>
            <h3>Address</h3>
            <p><%= address %></p>
          </div>
        <% } %>

        <% if (phone || phoneAlt) { %>
          <div class="contact-info-card">
            <div class="contact-info-icon">📞</div>
            <h3>Phone</h3>
            <% if (phone) { %>
              <p><a href="tel:<%= phone.replace(/\s+/g, '') %>"><%= phone %></a></p>
            <% } %>
            <% if (phoneAlt) { %>
              <p><a href="tel:<%= phoneAlt.replace(/\s+/g, '') %>"><%= phoneAlt %></a></p>
            <% } %>
          </div>
        <% } %>

        <% if (email) { %>
          <div class="contact-info-card">
            <div class="contact-info-icon">✉</div>
            <h3>Email</h3>
            <p><a href="mailto:<%= email %>"><%= email %></a></p>
          </div>
        <% } %>

        <% if (hours) { %>
          <div class="contact-info-card">
            <div class="contact-info-icon">🕐</div>
            <h3>Office Hours</h3>
            <p><%= hours %></p>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="contact-form-wrap">

      <% if (errors && errors.length) { %>
        <div class="contact-error-box">
          <strong>Please fix the following:</strong>
          <ul>
            <% errors.forEach((e) => { %>
              <li><%= e.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <h2 class="contact-form-title">Send us a message</h2>
      <p class="contact-form-subtitle">All fields marked <span style="color: #c0392b;">*</span> are required.</p>

      <form action="/contact" method="POST" class="contact-form" novalidate>

        <div class="form-row">
          <label for="name">Your name <span style="color: #c0392b;">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= form.name %>"
            required
            minlength="2"
            maxlength="120"
            autocomplete="name">
        </div>

        <div class="form-row">
          <label for="email">Email address <span style="color: #c0392b;">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= form.email %>"
            required
            maxlength="180"
            autocomplete="email"
            inputmode="email">
        </div>

        <div class="form-row">
          <label for="phone">Phone (optional)</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            value="<%= form.phone %>"
            maxlength="40"
            autocomplete="tel"
            inputmode="tel">
        </div>

        <div class="form-row">
          <label for="subject">Subject (optional)</label>
          <input
            type="text"
            id="subject"
            name="subject"
            value="<%= form.subject %>"
            maxlength="200">
        </div>

        <div class="form-row">
          <label for="message">Message <span style="color: #c0392b;">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            minlength="10"
            maxlength="5000"
            placeholder="How can we help you?"><%= form.message %></textarea>
          <span class="form-hint">
            <span id="msgCount"><%= (form.message || '').length %></span> / 5000
          </span>
        </div>

        <div class="contact-submit">
          <button type="submit" class="btn btn-primary">Send Message</button>
        </div>

      </form>
    </div>

  </div>
</section>

<script>
  (function () {
    var msg = document.getElementById('message');
    var counter = document.getElementById('msgCount');
    if (!msg || !counter) return;
    function update() { counter.textContent = msg.value.length; }
    msg.addEventListener('input', update);
    update();
  })();
</script>