<%
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var appUrl = (settings && settings.app_url) || 'http://localhost:3000';
  var firstName = (application.full_name || '').split(/\s+/)[0] || 'there';

  var hasFee = Number(application.tier_fee || 0) > 0;
  var isPaid = application.payment_status === 'paid';
  var isPendingPayment = application.payment_status === 'pending' && hasFee;

  var feeCurrency = application.payment_currency || application.tier_currency || 'NGN';
  var feeAmount = Number(application.payment_amount || application.tier_fee || 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application received</title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 28px; text-align: center;">
              <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 4px;">
                Membership Application
              </div>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding: 32px 28px 8px;">
              <h1 style="margin: 0 0 16px; font-size: 22px; color: #25573f; line-height: 1.3;">
                Thank you, <%= firstName %>.
              </h1>
              <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.7;">
                We've received your application for <strong><%= application.tier_name %></strong> membership.
              </p>
            </td>
          </tr>

          <!-- Reference -->
          <tr>
            <td style="padding: 8px 28px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #25573f; border-radius: 8px;">
                <tr>
                  <td style="padding: 18px 20px; text-align: center;">
                    <div style="font-size: 11px; color: rgba(255, 255, 255, 0.85); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">Your reference number</div>
                    <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 1px; font-family: monospace;">
                      <%= application.reference %>
                    </div>
                  </td>
                </tr>
              </table>
              <p style="margin: 10px 0 0; font-size: 13px; color: #6c757d; text-align: center;">
                Please keep this reference safe — you'll need it for any follow-up.
              </p>
            </td>
          </tr>

          <% if (isPendingPayment) { %>
            <!-- Payment required -->
            <tr>
              <td style="padding: 8px 28px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fff3cd; border: 1px solid #ffeeba; border-radius: 8px;">
                  <tr>
                    <td style="padding: 18px 20px;">
                      <div style="font-size: 14px; font-weight: 700; color: #856404; margin-bottom: 8px;">Payment required</div>
                      <p style="margin: 0 0 14px; font-size: 14px; line-height: 1.6; color: #212529;">
                        To complete your application, please pay the membership fee of
                        <strong><%= feeCurrency %> <%= feeAmount.toLocaleString() %></strong>.
                      </p>
                      <table role="presentation" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="background-color: #25573f; border-radius: 6px;">
                            <a href="<%= appUrl %>/membership/apply/<%= application.reference %>/pay"
                               style="display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 700; color: #ffffff; text-decoration: none;">
                              Pay Now
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          <% } else if (isPaid) { %>
            <!-- Payment confirmed -->
            <tr>
              <td style="padding: 8px 28px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px;">
                  <tr>
                    <td style="padding: 16px 20px;">
                      <div style="font-size: 14px; font-weight: 700; color: #155724; margin-bottom: 4px;">✓ Payment confirmed</div>
                      <div style="font-size: 13px; color: #155724;">
                        <%= feeCurrency %> <%= feeAmount.toLocaleString() %> received. Thank you!
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          <% } %>

          <!-- What's next -->
          <tr>
            <td style="padding: 8px 28px 20px;">
              <h2 style="margin: 0 0 12px; font-size: 16px; color: #25573f;">What happens next?</h2>
              <ol style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.9; color: #212529;">
                <% if (isPendingPayment) { %>
                  <li>Complete payment to finalize your submission.</li>
                <% } %>
                <li>Our membership team will review your application.</li>
                <li>This usually takes 3–5 business days.</li>
                <li>You'll receive an email with the outcome.</li>
              </ol>
            </td>
          </tr>

          <!-- Summary -->
          <tr>
            <td style="padding: 8px 28px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f7faf9; border-radius: 8px;">
                <tr>
                  <td style="padding: 18px 20px;">
                    <div style="font-size: 11px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 12px;">Application summary</div>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d; width: 40%;">Reference</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529; font-weight: 600;"><%= application.reference %></td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Tier</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529;"><%= application.tier_name %></td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Name</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529;"><%= application.full_name %></td>
                      </tr>
                      <tr>
                        <td style="padding: 6px 0; font-size: 13px; color: #6c757d;">Email</td>
                        <td style="padding: 6px 0; font-size: 13px; color: #212529; word-break: break-all;"><%= application.email %></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #edf3f2; padding: 20px 28px; border-top: 1px solid #dfeae8;">
              <p style="margin: 0 0 8px; font-size: 12px; color: #6c757d; line-height: 1.6;">
                Questions? Reply to this email or contact us at
                <a href="mailto:<%= (settings && settings.contact_email) || 'info@iavmn.org' %>" style="color: #25573f; text-decoration: none;">
                  <%= (settings && settings.contact_email) || 'info@iavmn.org' %>
                </a>
              </p>
              <p style="margin: 0; font-size: 12px; color: #6c757d;">
                &copy; <%= new Date().getFullYear() %> <%= siteName %>
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>