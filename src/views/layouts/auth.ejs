<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title + ' | ' + appName : appName %></title>

  <%
    var authFavicon = (settings && settings.site_favicon_path) || (settings && settings.site_logo_path) || null;
    var authTheme = (settings && settings.pwa_theme_color) || '#25573f';
  %>
  <meta name="theme-color" content="<%= authTheme %>">
  <% if (authFavicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= authFavicon %>">
    <link rel="apple-touch-icon" href="<%= authFavicon %>">
  <% } else { %>
    <link rel="icon" type="image/x-icon" href="/uploads/branding/favicon.ico">
  <% } %>

  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/responsive-helpers.css">
</head>
<body class="auth-body">

  <main class="auth-main">
    <div class="auth-card">
      <div class="auth-brand">
        <a href="/" class="auth-logo">
          <% if (settings && settings.site_logo_path) { %>
            <img src="<%= settings.site_logo_path %>" alt="<%= settings.site_name || appName %>" class="auth-logo-img">
          <% } else { %>
            <strong><%= (settings && settings.site_short_name) || appName %></strong>
          <% } %>
        </a>
      </div>

      <% if (typeof flash !== 'undefined' && Object.keys(flash).length > 0) { %>
        <div class="auth-flash">
          <% ['success', 'error', 'info', 'warning'].forEach(function (type) { %>
            <% if (flash[type]) { %>
              <% flash[type].forEach(function (msg) { %>
                <div class="flash flash-<%= type %>"><%= msg %></div>
              <% }); %>
            <% } %>
          <% }); %>
        </div>
      <% } %>

      <%- body %>

    </div>

    <p class="auth-footer">
      <a href="/">&larr; Back to site</a>
    </p>
  </main>

</body>
</html>