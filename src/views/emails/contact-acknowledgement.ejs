<%
  // Variables passed in: { message, appName, settings }
  var siteName = (settings && settings.site_name) || appName || 'IAVMN';
  var siteShort = (settings && settings.site_short_name) || 'IAVMN';
  var contactEmail = (settings && settings.contact_email) || 'info@iavmn.org';
  var contactPhone = (settings && settings.contact_phone) || null;
  var contactAddress = (settings && settings.contact_address) || null;
  var contactHours = (settings && settings.contact_hours) || null;
  var firstName = (message.name || '').split(/\s+/)[0] || 'there';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>We received your message</title>
</head>
<body style="margin: 0; padding: 0; background-color: #edf3f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #212529; line-height: 1.6;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #edf3f2; padding: 24px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">

          <!-- Header -->
          <tr>
            <td style="background-color: #25573f; padding: 28px; text-align: center;">
              <div style="font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px;">
                <%= siteShort %>
              </div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 4px;">
                <%= siteName %>
              </div>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding: 32px 28px 12px;">
              <h1 style="margin: 0 0 16px; font-size: 22px; color: #25573f; line-height: 1.3;">
                Thank you, <%= firstName %>.
              </h1>
              <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.7;">
                We've received your message and a member of our team will get back to you as soon as possible — usually within one business day.
              </p>
              <p style="margin: 0; font-size: 15px; line-height: 1.7;">
                For your records, here's a copy of what you sent us:
              </p>
            </td>
          </tr>

          <!-- Copy of submission -->
          <tr>
            <td style="padding: 16px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f7faf9; border-left: 4px solid #b9a446; border-radius: 6px;">
                <tr>
                  <td style="padding: 18px 20px;">
                    <% if (message.subject) { %>
                      <div style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; padding-bottom: 4px;">Subject</div>
                      <div style="font-size: 15px; font-weight: 600; color: #212529; padding-bottom: 14px;">
                        <%= message.subject %>
                      </div>
                    <% } %>

                    <div style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; padding-bottom: 6px;">Your message</div>
                    <div style="font-size: 14px; line-height: 1.7; color: #212529; white-space: pre-wrap;">
                      <%= message.message %>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Info block -->
          <tr>
            <td style="padding: 16px 28px 8px;">
              <h2 style="margin: 0 0 12px; font-size: 16px; color: #25573f;">
                While you wait, you may also find these helpful:
              </h2>
              <ul style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.9; color: #212529;">
                <li><a href="<%= (settings && settings.app_url) || '#' %>/membership" style="color: #25573f; text-decoration: none; font-weight: 600;">Explore membership categories</a></li>
                <li><a href="<%= (settings && settings.app_url) || '#' %>/faq" style="color: #25573f; text-decoration: none; font-weight: 600;">Read our frequently asked questions</a></li>
                <li><a href="<%= (settings && settings.app_url) || '#' %>/news" style="color: #25573f; text-decoration: none; font-weight: 600;">Catch up on our latest news</a></li>
              </ul>
            </td>
          </tr>

          <!-- Direct contact -->
          <% if (contactEmail || contactPhone || contactAddress) { %>
            <tr>
              <td style="padding: 20px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #dfeae8;">
                  <tr>
                    <td style="padding-top: 18px;">
                      <div style="font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; padding-bottom: 8px;">
                        Or reach us directly
                      </div>
                      <% if (contactEmail) { %>
                        <div style="font-size: 14px; line-height: 1.8;">
                          <strong>Email:</strong>
                          <a href="mailto:<%= contactEmail %>" style="color: #25573f; text-decoration: none;"><%= contactEmail %></a>
                        </div>
                      <% } %>
                      <% if (contactPhone) { %>
                        <div style="font-size: 14px; line-height: 1.8;">
                          <strong>Phone:</strong>
                          <a href="tel:<%= contactPhone.replace(/\s+/g, '') %>" style="color: #25573f; text-decoration: none;"><%= contactPhone %></a>
                        </div>
                      <% } %>
                      <% if (contactAddress) { %>
                        <div style="font-size: 14px; line-height: 1.8;">
                          <strong>Address:</strong> <%= contactAddress %>
                        </div>
                      <% } %>
                      <% if (contactHours) { %>
                        <div style="font-size: 14px; line-height: 1.8;">
                          <strong>Hours:</strong> <%= contactHours %>
                        </div>
                      <% } %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          <% } %>

          <!-- Footer -->
          <tr>
            <td style="background-color: #edf3f2; padding: 20px 28px; border-top: 1px solid #dfeae8;">
              <p style="margin: 0; font-size: 12px; color: #6c757d; line-height: 1.6;">
                You received this email because you submitted the contact form on <%= siteName %>.
                If this wasn't you, you can safely ignore this email.
              </p>
            </td>
          </tr>

        </table>

        <p style="margin: 16px 0 0; font-size: 12px; color: #6c757d; text-align: center;">
          &copy; <%= new Date().getFullYear() %> <%= siteName %>
        </p>

      </td>
    </tr>
  </table>

</body>
</html>